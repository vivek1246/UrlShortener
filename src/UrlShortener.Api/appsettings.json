{
  "ConnectionStrings": {
    "Default": "Data Source=urlshortener.db"
  },
  "RateLimiting": {
    "ShortenPermitLimit": 10,
    "ShortenWindowMinutes": 1
  },
  "Cache": {
    "LinkTtlMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}